# docker-compose.yml (replace existing)
services:
  backend:
    build: ./backend
    volumes:
      - ./backend:/code
      - ./backend/media:/code/media
      - ./ml:/workspace
      - ./ml/saved_models:/workspace/saved_models
      - ./ml/tfjs_model_output:/workspace/tfjs_model_output
    environment:
      - DJANGO_SETTINGS_MODULE=project.settings
      - PYTHONUNBUFFERED=1
      - POSTGRES_DB=tobaccodb
      - POSTGRES_USER=postgres
      - POSTGRES_PASSWORD=postgres
      - POSTGRES_HOST=db
      - POSTGRES_PORT=5432
      - MODEL_KERAS_PATH=/workspace/saved_models/saved_model
      - MODEL_TFLITE_PATH=
      - MODEL_CLASSES_TXT=/workspace/classes.txt
      - DEBUG=1
      # IMPORTANT: point backend at mlserve via host.docker.internal:8001
      - MLSERVE_URL=http://host.docker.internal:8001/infer
    ports:
      - "8000:8000"
    depends_on:
      - db
    command: ["./entrypoint.sh"]

  web:
    build: ./web-admin
    volumes:
      - ./web-admin:/app
      - /app/node_modules
    ports:
      - "3000:3000"
    environment:
      - CHOKIDAR_USEPOLLING=true

  ml:
    build: ./ml
    volumes:
      - ./ml:/workspace
      - ./data/roboflow_tobacco:/workspace/data/roboflow_tobacco
      - ./data/tobacco_processed:/workspace/data/tobacco_processed
      - ./ml/saved_models:/workspace/saved_models
      - ./ml/tfjs_model_output:/workspace/tfjs_model_output
    command: ["bash"]
    ports:
      - "8888:8888"

  mlserve:
    image: ml-fastapi
    volumes:
      - ./ml:/workspace
      - ./ml/saved_models:/workspace/saved_models
      - ./ml/classes.json:/workspace/classes.json
    environment:
      - ML_MODEL_PATH=/workspace/saved_models/saved_model
      - ML_CLASSES_JSON=/workspace/classes.json
      - ML_IMG_SIZE=224
    # host:container mapping -> container exposes 8000; we publish it on host 8001
    ports:
      - "8001:8000"
    command: ["uvicorn", "serve:app", "--host", "0.0.0.0", "--port", "8000"]
    depends_on:
      - ml

  db:
    image: postgres:15
    restart: always
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: tobaccodb
    volumes:
      - postgres_data:/var/lib/postgresql/data
    ports:
      - "5433:5432"

volumes:
  postgres_data:
